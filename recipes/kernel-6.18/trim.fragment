# Subtracted from Firecracker's official microvm-kernel-ci-x86_64-6.18.config (docs/003-guest.md, 内核层).
# -- attack surface / things a sandbox guest never needs
CONFIG_MODULES=n
CONFIG_IO_URING=n
CONFIG_USER_NS=n
CONFIG_BPF_SYSCALL=n
CONFIG_BPF_JIT=n
CONFIG_KPROBES=n
CONFIG_HIBERNATION=n
CONFIG_PM=n
CONFIG_NETFILTER=n
CONFIG_BRIDGE=n
CONFIG_IPV6=n
CONFIG_NFS_FS=n
CONFIG_NFSD=n
CONFIG_INPUT=n
CONFIG_HID=n
CONFIG_SOUND=n
CONFIG_SQUASHFS=n
CONFIG_FUSE_FS=n
CONFIG_SECURITY_SELINUX=n
CONFIG_SECURITY_SMACK=n
CONFIG_SECURITY_TOMOYO=n
CONFIG_SECURITY_APPARMOR=n
CONFIG_SECURITY_LOADPIN=n
CONFIG_SECURITY_SAFESETID=n
CONFIG_INTEGRITY=n
CONFIG_LSM="landlock,lockdown,yama"
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
CONFIG_DEBUG_INFO_NONE=y
# -- keep / add
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_CGROUPS=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_FS_DAX=y
CONFIG_LIBNVDIMM=y
CONFIG_BLK_DEV_PMEM=y
CONFIG_VIRTIO_PMEM=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_MMIO=y
CONFIG_KALLSYMS=y
