{
  "name": "cairnbox",
  "version": "0.1.0",
  "description": "JavaScript / TypeScript SDK for the Cairn sandbox cloud (CONTRACT \u00a71 over HTTP). No runtime dependencies; uses fetch (Node 18+, Deno, Bun, browsers).",
  "type": "module",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && npm test",
    "test": "node --no-warnings --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
