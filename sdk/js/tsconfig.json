{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2022", "DOM"],
    "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "erasableSyntaxOnly": true, "types": ["node"]
  },
  "include": ["src", "test", "e2e"]
}
