# Copy to .env and edit. Paths are relative to this directory unless absolute.
REPO_DIR=..                 # the checkout (images/, recipes/templates, web/, eval/, intake/ are mounted from it)
DATA_DIR=.                  # where state lives: state/ (node), cp-state/, store/, db-data/, registry-data/, model-state/, eval-state/, intake-state/
SECRETS_DIR=./secrets       # cp.token, db.password (generated by `make-secrets.sh`), deepseek.key, gitea-cairn-bot.token (yours)
NODE_IMAGE=fc-node:dev      # docker build -t fc-node:dev -f node/Dockerfile .   (from REPO_DIR)
CP_IMAGE=fc-cp:dev          # DOCKER_BUILDKIT=1 docker build -t fc-cp:dev cp/
MAX_VMS=32
MEM_BUDGET_MIB=8192
HOST_VCPUS=16
JAIL=1
DEFAULT_TEMPLATE=debian-13
# Warm starts: the node builds these template snapshots at start and keeps `ready` booted VMs of each (D44: 85 ms instead of 400 ms per create)
TEMPLATE_POOL=[{"mem":512,"vcpu":1,"ready":1}]
MODEL_BACKEND=mock          # upstream + UPSTREAM_URL=https://api.deepseek.com/v1 for a real model (key in SECRETS_DIR/deepseek.key)
EVAL_LAYERS=                # after node/build-layer.sh: <langs-layer-id>,<harness-layer-id>
INTAKE_LAYERS=              # <langs>,<harness>,<dev>
INTAKE_PROJECT=
GITEA_URL=
GITEA_REPO=
NETWORK=fcnet
NETWORK_EXTERNAL=false      # true when the network already exists (a host that also runs run-node.sh)
